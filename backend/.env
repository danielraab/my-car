# Copy to .env and adjust. Every value here is a placeholder; never commit a
# real secret. These names match what docker-compose.yml sets for the app
# service, so the two stay in step.

# HTTP listener.
PORT=8080

# PostgreSQL connection string. The compose db service exposes 5432 on the
# host, so a `go run .` on the host can use this as-is.
DATABASE_URL=postgres://mycars:mycars@localhost:5432/mycars?sslmode=disable

# Outgoing mail, used by the magic-link login. The compose dev profile runs
# mailpit as a throwaway catcher on 1025, with its web UI on 8025.
SMTP_FROM=admin@example.com
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_TLS=none
# Optional SMTP authentication. Leave both empty for unauthenticated relays
# such as the local Mailpit development catcher.
SMTP_USER=
SMTP_PASSWORD=

# Public base URL the backend builds absolute links from, such as the magic
# link it mails out and the OIDC redirect URI.
AUTH_BASE_URL=http://localhost:8080

# Optional generic OIDC login. Leave all three empty for magic-link-only mode,
# or configure all three together. The backend reads everything else from the
# issuer's discovery document. Register this redirect URI with the provider:
# http://localhost:8080/api/v1/auth/oidc/callback
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Rate limiting of the public sign-in endpoints. Behind a reverse proxy, list
# the addresses (IPs or CIDR ranges, comma-separated) it connects from, so the
# client address is taken from its X-Forwarded-For header; see README.md for a
# Traefik example. Leave empty when clients connect directly.
TRUSTED_PROXIES=
# Set to false to turn per-client-address limiting off when the trusted proxies
# cannot be specified. The per-recipient magic-link limit stays active.
RATE_LIMIT_PER_IP=true

# Optional raw HTML inserted into every served page just before </head>, for
# example an analytics tracker. Every visitor is tracked alike; choosing a tool
# that needs no consent banner (such as cookieless Umami) is up to the operator.
# Single-quote the value, e.g.:
# ANALYTICS_SNIPPET='<script defer src="https://umami.example/script.js" data-website-id="..."></script>'
ANALYTICS_SNIPPET=
