{
  "name": "frontend",
  "version": "2.4.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "dev": "vite dev --port 3000",
    "generate-routes": "tsr generate",
    "generate:api": "openapi-typescript ../openapi/openapi.yaml -o src/api/schema.gen.ts",
    "check:api": "openapi-typescript ../openapi/openapi.yaml | cmp -s - src/api/schema.gen.ts",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "format": "biome format",
    "lint": "biome lint",
    "check": "biome check",
    "lint:openapi": "redocly lint ../openapi/openapi.yaml --config ../redocly.yaml"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.10",
    "@tailwindcss/vite": "^4.3.5",
    "@tanstack/react-query": "^5.107.1",
    "@tanstack/react-router": "latest",
    "i18next": "^26.4.4",
    "lucide-react": "^1.70.0",
    "pdfjs-dist": "^6.5.438",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-i18next": "^17.0.16",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.6",
    "@redocly/cli": "2.76.0",
    "@tanstack/router-cli": "^1.167.46",
    "@tanstack/router-plugin": "latest",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.6",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.2.1",
    "jsdom": "^30.1.2",
    "openapi-typescript": "^7.13.0",
    "typescript": "^6.0.2",
    "vite": "^8.3.6",
    "vitest": "^5.1.0"
  },
  "intent": {
    "skills": [
      "*"
    ]
  }
}
